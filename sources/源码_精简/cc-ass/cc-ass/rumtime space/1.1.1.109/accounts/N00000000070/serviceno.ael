context 01010004118 {
	01010004118 => {
		Wait(0.5);
		FROM_CID=${CALLERID(num)};
		FROM_DID=${EXTEN};
		FROM_CONTEXT="${CONTEXT}";
		ACCOUNT=N00000000070;
		SERVICE_NO_TYPE="400";
		Wait(0.5);
		Agi(agi://127.0.0.1:7891/gaicalllimit?pbx=${HOST}&servicepeer=01010004118);
		Answer;
		Wait(1);

		loop:
		
		goto N00000000070-10009-blacklist,${FROM_CID},1;
	}
}

context 01010004118-ivrlogin {
	s => {
		BackGround(sound/ivrlogin);
		WaitExten(20);
	}
	
	1 => {
		goto 01010004118-jobnumconfirm,s,1;	
	}
	
	2 => {
		goto 01010004118-jobnumconfirmout,s,1;
	}
	
	3 => {
		goto 01010004118,01010004118,loop;
	}

	4 => {
		goto ivr-flow-checking,s,1;
	}
	
	t => {
    	Playback(sound/timeout);
        Playback(sound/bye);
        Hangup();
    }
    
	i => {
        BackGround(sound/incorrect);
		goto s,1;
    }
}

context 01010004118-jobnumconfirm {
	s => {
		input="";
		BackGround(sound/importjobnum);
		
		loop:
		WaitExten(20);
	}
	
	_[0-9] => {
		input=${input}${EXTEN};
		if(${LEN(${input})} > 10){
			Playback(sound/jobnumincorrect);
			goto s,1;
		}
		goto s,loop;
	}
	
	# => {
		if(${LEN(${input})} > 10 || ${LEN(${input})} < 1){
			Playback(sound/jobnumincorrect);
			goto s,1;
		}
		goto 01010004118-ivrlogined,s,1;
	}
	
	* => {
		Playback(sound/jobnumincorrect);
		goto s,1;
	}
}

context 01010004118-jobnumconfirmout {
	s => {
		input="";
		BackGround(sound/importjobnum);
		
		loop:
		WaitExten(20);
	}
	
	_[0-9] => {
		input=${input}${EXTEN};
		if(${LEN(${input})} > 10){
			Playback(sound/jobnumincorrect);
			goto s,1;
		}
		goto s,loop;
	}
	
	# => {
		if(${LEN(${input})} > 10 || ${LEN(${input})} < 1){
			Playback(sound/jobnumincorrect);
			goto s,1;
		}
		goto 01010004118-ivrlogout,s,1;
	}
	
	* => {
		Playback(sound/jobnumincorrect);
		goto s,1;
	}
}

context 01010004118-ivrlogined {
	s => {
		ivrloginsucceed=0;
		Agi(agi://127.0.0.1:7891/AgiProcessIvrLogin?pbx=${HOST}&exten=${input});
		if(${ivrloginsucceed} == 1){
			Playback(sound/ivrloginsuccess);
			Wait(1);
			Hangup;
		} else if(${ivrloginsucceed} == 500){
			Playback(sound/beyond);
			goto 01010004118-ivrlogin,s,1;		
		} else if(${ivrloginsucceed} == 501){
			Playback(sound/jobnumincorrect);
			goto 01010004118-ivrlogin,s,1;
		} else {
			Playback(sound/failed);
			goto 01010004118-ivrlogin,s,1;
		}
		
	}
}

context 01010004118-ivrlogout {
	s => {
		ivrlogoutsucceed=0;
		Agi(agi://127.0.0.1:7891/AgiProcessIvrLogout?pbx=${HOST}&exten=${input});
		if(${ivrlogoutsucceed} == 1){
			Playback(sound/ivrlogoutsuccess);
			Wait(1);
			Hangup;
		} else if(${ivrlogoutsucceed} == 501){
			Playback(sound/jobnumincorrect);
			goto 01010004118-ivrlogin,s,1;
		} else{
			Playback(sound/failed);
			goto 01010004118-ivrlogin,s,1;
		}
	}
}

