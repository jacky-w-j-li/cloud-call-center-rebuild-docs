globals {
	HOST="1.1.1.101";
}

macro IVR_KEY_TAG() {
        Set(KEY_TAG=1);
}

context default {
	_X. => goto ${EXTEN},${EXTEN},1;
	_ACCX. => {
		Noop(${EXTEN});
		goto ${EXTEN:7},${EXTEN:3:4},1;
	}
	_[A-Z]X. => goto dial-account,${EXTEN},1;
}

context dial-account {
        _. => {
                if(${SIP_HEADER(REFUNIQUEID)}"a" != "a"){
                        REFUNIQUEID = ${SIP_HEADER(REFUNIQUEID)};
                } else {
                        Noop("Null refuniqueid");
                }
                C5-account=${EXTEN:0:12};
                C5-exten=${EXTEN:12};
                goto ${c5-account},${c5-exten},1;
        }
}

context dial-exten {
	_. => {
		
	}
}

context balance {
        _. => {
                 Playback(sound/balance);
                 Hangup();
        }
}

context no-sipuser-bind {
        _. => {
                Playback(sound/nosipuser);
                Hangup();
        }
}

context dialout-voerload {
        _. => {
                 Playback(sound/outboundCallOverLoad);
                 Hangup();
        }
}

context threewaycall {
        _X. => {
                Answer;
		ORI_MEETME_NUM = ${EXTEN};
                MeetMe(${EXTEN},dqpx1MF);
		goto N00000000143-10238-ivr, ${FROM_DID}, 1; 
        }
}

context musiconhold {
        s => {
                MusicOnHold();
        }
}

context agentbusy {
        s => {
                BackGround(sound/busybye);
        }
}

context dialout-gateway {
        _. => {
		//CALLERID(num) = "95013735621";	
		//Dial(SIP/18600030392@210.21.118.215:6060);
                Dial(SIP/${EXTEN}@127.0.0.1:5072);
        }
        h => {
                Hangup();
        }
}

context ivr-flow-checking {
        s => {
                input="";
                Playback(sound/flowchecking);
                loop:
                        WaitExten(20);
        }

        _[0-9] => {
                input=${input}${EXTEN};
                goto s,loop;
        }

        # => {
                if("${ACCOUNT}"==""){
                        MusicOnHold();
                }else{
                        goto ${ACCOUNT},${input},1;
                }
        }

        i => {
                Playback(sound/incorrect);
                goto s,loop;
        }

        t => {
                Playback(sound/timeout);
                goto s,1;
        }
}

context outboundBlackList{
        s => {
                Playback(sound/outboundblacklist);
                Hangup();
        }
}

context ucpolling {
        _X. => {
                POLLSIPNUM = ${CUT(EXTEN|_|1)};
                POLLLOCALNUM = ${CUT(EXTEN|_|2)};
                POLLGATEWAYNUM = ${CUT(EXTEN|_|3)};

                if(${POLLGATEWAYNUM}!=null ){
                        Dial(SIP/${POLLGATEWAYNUM},15);
                }
                if(${POLLSIPNUM}!=null ){
                        Dial(SIP/${POLLSIPNUM},15);
                }
                if(${POLLLOCALNUM}!=null ){
                        Dial(SIP/${POLLLOCALNUM},30);
                }
                Hangup();
        }
        h => {
                Hangup();
        }
}

context transfer-gateway {
        _. => {
                Dial(SIP/${EXTEN}@127.0.0.1:5072,30);
                Playback(sound/transferfailed);
                goto musiconhold,s,1;
        }
        h => {
                Hangup;
        }
}

context transfer-dialin {
        _. => {
                CALLERID(num)=${CALLERID(num):17};
                Dial(SIP/${EXTEN},30);
                Playback(sound/transferfailed);
                goto musiconhold,s,1;
        }
        h => {
                Hangup;
        }
}

context ivr-menu-end {
      s => {
            MusicOnHold();
      }
}

context ivr-menu-main-hangup {
      s => {
            Playback(sound/ivrmenumainhangup);
            Hangup;
      }
}

context ivr-menu-second-hangup {
      s => {
            Playback(sound/ivrmenusecondhangup);
            Hangup;
      }
}

#include "extensions-sip.ael"
#include "extensions_include.ael"
