context N00000000184-10045-time {
	_X. => {
		ifTime(*|mon|*|*) {
			goto N00000000184-10044-announcement,${FROM_DID},1;
		}
		ifTime(*|tue|*|*) {
			goto N00000000184-10044-announcement,${FROM_DID},1;
		}
		ifTime(*|wed|*|*) {
			goto N00000000184-10044-announcement,${FROM_DID},1;
		}
		ifTime(*|thu|*|*) {
			goto N00000000184-10044-announcement,${FROM_DID},1;
		}
		ifTime(*|fri|*|*) {
			goto N00000000184-10044-announcement,${FROM_DID},1;
		}
		ifTime(*|sat|*|*) {
			goto N00000000184-10044-announcement,${FROM_DID},1;
		}
		ifTime(*|sun|*|*) {
			goto N00000000184-10044-announcement,${FROM_DID},1;
		}

		Hangup;
	}
}


