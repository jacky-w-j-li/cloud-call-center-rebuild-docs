context N00000000246-10012-ivr {
	_X. => {
		FROM_CONTEXT="${CONTEXT}";
		if("${FROM_IVR}a" == "a")
            FROM_IVR="";
		goto N00000000246-10012-ivr-input,s,1;
	}
}

context N00000000246-10012-ivr-input {
	s => {
		INPUT_RETRY_TIMES=0;
		loop:
		BackGround(/etc/asterisk/1.1.1);
		WaitExten(10);
	}

	1 => {
		KEY_OF_IVR=${EXTEN};
		if("${FROM_IVR}foo" == "foo")
			FROM_IVR=10012@${EXTEN};
		else 
			FROM_IVR="${FROM_IVR}-10012@1";	
		Set(__IVRKEY=${FROM_IVR});
		goto N00000000246-10014-assignment,s,1;
	}

	2 => {
		KEY_OF_IVR=${EXTEN};
		if("${FROM_IVR}foo" == "foo")
			FROM_IVR=10012@${EXTEN};
		else 
			FROM_IVR="${FROM_IVR}-10012@2";	
		Set(__IVRKEY=${FROM_IVR});
		goto N00000000246-10025-encryptmd5,s,1;
	}

	3 => {
		KEY_OF_IVR=${EXTEN};
		if("${FROM_IVR}foo" == "foo")
			FROM_IVR=10012@${EXTEN};
		else 
			FROM_IVR="${FROM_IVR}-10012@3";	
		Set(__IVRKEY=${FROM_IVR});
		goto N00000000246-10005-textannouncement,s,1;
	}

	4 => {
		KEY_OF_IVR=${EXTEN};
		if("${FROM_IVR}foo" == "foo")
			FROM_IVR=10012@${EXTEN};
		else 
			FROM_IVR="${FROM_IVR}-10012@4";	
		Set(__IVRKEY=${FROM_IVR});
		goto N00000000246-10016-validate,s,1;
	}

	5 => {
		KEY_OF_IVR=${EXTEN};
		if("${FROM_IVR}foo" == "foo")
			FROM_IVR=10012@${EXTEN};
		else 
			FROM_IVR="${FROM_IVR}-10012@5";	
		Set(__IVRKEY=${FROM_IVR});
		goto N00000000246-10000137-queue,10000137,1;
	}



	i => {
		INPUT_RETRY_TIMES=${INPUT_RETRY_TIMES} + 1;
		if(${INPUT_RETRY_TIMES} >= 3){
			Playback(sound/bye);
			Hangup();
		}
		Playback(sound/incorrect);
		goto s,loop;
	}
	
	t => {
		INPUT_RETRY_TIMES=${INPUT_RETRY_TIMES} + 1;
		if(${INPUT_RETRY_TIMES} >= 3){
			Playback(sound/bye);
			Hangup();
		}
		Playback(sound/timeout);
		goto s,loop;
	}
}


