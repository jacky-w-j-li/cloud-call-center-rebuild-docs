context N00000000246-10021-satisfaction {
    s => {
        RETRY_TIME = 0;
        input = "";
        
    loop:
        RETRY_TIME=${RETRY_TIME} + 1;
        if(${RETRY_TIME} > 3){
        	Playback(sound/bye);
            Hangup();
        }
        BackGround(/etc/asterisk/1.1.1.101/accounts/N00000000246/sound/86fa3ddb21df77c710695dbdf50ade99);
        WaitExten(5);
    }

    _[0-9] => {
    
    	VALID_FLAG = 0;
    	Agi(agi://127.0.0.1:7891/AgiSatisfactionValidate?pbx=${HOST}&exten=${EXTEN});
    	
    	if(${VALID_FLAG} == 1){
    		goto N00000000246-10021-satisfaction-result, ${EXTEN}, 1;
    	}else{
    		if(${RETRY_TIME} > 3){
	        	Playback(sound/bye);
	            Hangup();
        	}else{
	    		BackGround(sound/invalid);
	    		goto s,loop;
        	}
    	}
    }
    
    i => {
    	if(${RETRY_TIME} == 0){
            goto s, loop;
        }
        if(${RETRY_TIME} > 3){
            Playback(sound/bye);
            Hangup();
        }
        BackGround(sound/invalid);
        goto s, loop;
    }

    t => {
        if(${RETRY_TIME} > 3){
            Playback(sound/bye);
            Hangup();
        }
        Playback(sound/timeout);
        goto s, loop;
    }

}

context N00000000246-10021-satisfaction-result {
    _X => {
    	KEY_SAT=${exten};
        Playback(/etc/asterisk/1.1.1.101/accounts/N00000000246/sound/6f18e00162a0ae32a133a86a76cb74ce);
        Wait(1);
        goto N00000000246-10011-textannouncement,s,1;
    }
}


