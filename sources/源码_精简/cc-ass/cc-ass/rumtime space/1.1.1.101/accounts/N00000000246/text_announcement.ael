context N00000000246-10005-textannouncement {
	s => {
		Agi(agi://127.0.0.1:7891/agittszh?pbx=${HOST}&servicepeer=10005);
		if("${TTSENGINE}" == "1"){
			Playback(${FILENAME});	
		}
		goto N00000000246-10022-textannouncement,s,1;
	}
}


