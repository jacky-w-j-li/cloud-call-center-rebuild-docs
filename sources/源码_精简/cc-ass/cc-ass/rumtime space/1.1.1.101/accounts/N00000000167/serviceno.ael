context 01053500347 {
	01053500347 => {
		Wait(0.5);
		FROM_CID=${CALLERID(num)};
		FROM_DID=${EXTEN};
		FROM_CONTEXT="${CONTEXT}";
		ACCOUNT=N00000000167;
		SERVICE_NO_TYPE="normal";
		Wait(0.5);
		Agi(agi://127.0.0.1:7891/gaicalllimit?pbx=${HOST}&servicepeer=01053500347);
		Answer;
		Wait(1);
		if( "${FROM_CID}" = "111") {
			goto 01053500347-ivrlogin,s,1;
		}
		if( "${FROM_CID}" = "018235893053") {
			goto 01053500347-ivrlogin,s,1;
		}
		if( "${FROM_CID}" = "18235893053") {
			goto 01053500347-ivrlogin,s,1;
		}
		if( "${FROM_CID}" = "015701330752") {
			goto 01053500347-ivrlogin,s,1;
		}
		if( "${FROM_CID}" = "15701330752") {
			goto 01053500347-ivrlogin,s,1;
		}

		loop:
		
		goto N00000000167-10006-blacklist,${FROM_CID},1;
	}
}

context 01053500347-ivrlogin {
	s => {
		BackGround(sound/ivrlogin);
		WaitExten(20);
	}
	
	1 => {
		goto 01053500347-jobnumconfirm,s,1;	
	}
	
	2 => {
		goto 01053500347-jobnumconfirmout,s,1;
	}
	
	3 => {
		goto 01053500347,01053500347,loop;
	}

	4 => {
		goto ivr-flow-checking,s,1;
	}
	
	t => {
    	Playback(sound/timeout);
        Playback(sound/bye);
        Hangup();
    }
    
	i => {
        BackGround(sound/incorrect);
		goto s,1;
    }
}

context 01053500347-jobnumconfirm {
	s => {
		input="";
		BackGround(sound/importjobnum);
		
		loop:
		WaitExten(20);
	}
	
	_[0-9] => {
		input=${input}${EXTEN};
		if(${LEN(${input})} > 10){
			Playback(sound/jobnumincorrect);
			goto s,1;
		}
		goto s,loop;
	}
	
	# => {
		if(${LEN(${input})} > 10 || ${LEN(${input})} < 1){
			Playback(sound/jobnumincorrect);
			goto s,1;
		}
		goto 01053500347-ivrlogined,s,1;
	}
	
	* => {
		Playback(sound/jobnumincorrect);
		goto s,1;
	}
}

context 01053500347-jobnumconfirmout {
	s => {
		input="";
		BackGround(sound/importjobnum);
		
		loop:
		WaitExten(20);
	}
	
	_[0-9] => {
		input=${input}${EXTEN};
		if(${LEN(${input})} > 10){
			Playback(sound/jobnumincorrect);
			goto s,1;
		}
		goto s,loop;
	}
	
	# => {
		if(${LEN(${input})} > 10 || ${LEN(${input})} < 1){
			Playback(sound/jobnumincorrect);
			goto s,1;
		}
		goto 01053500347-ivrlogout,s,1;
	}
	
	* => {
		Playback(sound/jobnumincorrect);
		goto s,1;
	}
}

context 01053500347-ivrlogined {
	s => {
		ivrloginsucceed=0;
		Agi(agi://127.0.0.1:7891/AgiProcessIvrLogin?pbx=${HOST}&exten=${input});
		if(${ivrloginsucceed} == 1){
			Playback(sound/ivrloginsuccess);
			Wait(1);
			Hangup;
		} else if(${ivrloginsucceed} == 500){
			Playback(sound/beyond);
			goto 01053500347-ivrlogin,s,1;		
		} else if(${ivrloginsucceed} == 501){
			Playback(sound/jobnumincorrect);
			goto 01053500347-ivrlogin,s,1;
		} else {
			Playback(sound/failed);
			goto 01053500347-ivrlogin,s,1;
		}
		
	}
}

context 01053500347-ivrlogout {
	s => {
		ivrlogoutsucceed=0;
		Agi(agi://127.0.0.1:7891/AgiProcessIvrLogout?pbx=${HOST}&exten=${input});
		if(${ivrlogoutsucceed} == 1){
			Playback(sound/ivrlogoutsuccess);
			Wait(1);
			Hangup;
		} else if(${ivrlogoutsucceed} == 501){
			Playback(sound/jobnumincorrect);
			goto 01053500347-ivrlogin,s,1;
		} else{
			Playback(sound/failed);
			goto 01053500347-ivrlogin,s,1;
		}
	}
}

