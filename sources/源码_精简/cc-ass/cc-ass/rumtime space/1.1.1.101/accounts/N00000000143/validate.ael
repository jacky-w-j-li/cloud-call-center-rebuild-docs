context N00000000143-10090-validate{
    s => {
        input="";
    	
      loop:
        WaitExten(20);
    }

    _[0-9] => {
        input=${input}${EXTEN};
        if(${LEN(${input})} > 30){
                Playback(sound/incorrect);
                goto s,1;
        }
        goto s,loop;
    }

    * => goto s, 1;

    # => {
        if(${LEN(${input})} > 30 || ${LEN(${input})} < 0){
                Playback(sound/incorrect);
                goto s,1;
        }
        FROM_CID=${input};
        goto N00000000143-10090-transflow, ${input}, 1;
    }

    i => {
        Playback(sound/incorrect);
        goto s, 1;
    }

    t => {
        Playback(sound/timeout);
        Hangup;
    }
}

context N00000000143-10090-transflow {
    _. => {
		goto N00000000143-10158-announcement,${FROM_DID},1;
    }
}

