context N00000000143-10232-ExtensionPeer {
s => {
                abc="18600030392,18600030392,18600030392";
                loop:
                        Playtones(ring);
                        if(${LEN(${abc})} > 11){
                                curAbc = ${abc:0:11};

                                abc=${abc:12}

                                FROM_DID=${curAbc};
                                //goto N00000000143-dial, 9${curAbc},1;
                                CALLERID(num)="01085659293";
                                StopMonitor();
                                Set(RECFILENAME=${STRFTIME(${EPOCH},,%Y%m%d-%H%M%S)}_N00000000143_${CALLERID(num)}_${EXTEN}_${UNIQUEID});
                                Monitor(wav,${RECFILENAME},b);
                                Set(DYNAMIC_FEATURES=key_tag);

                                Dial(SIP/N000000001431900${curAbc}@127.0.0.1:5072,15,r);
                                if("${DIALSTATUS}" != "ANSWER"){
                                        Playtones(ring);
                                        goto s,loop;
                                }
                        }else{
                                FROM_DID=${abc};
                                CALLERID(num)="01085659293";
                                StopMonitor();
                                Set(RECFILENAME=${STRFTIME(${EPOCH},,%Y%m%d-%H%M%S)}_N00000000143_${CALLERID(num)}_${EXTEN}_${UNIQUEID});
                                Monitor(wav,${RECFILENAME},b);
                                Set(DYNAMIC_FEATURES=key_tag);

                                Dial(SIP/N000000001431900${abc}@127.0.0.1:5072,15,Ttr);
                                Hangup();
                        }

        }
}
