context sip-manage {
	s => {
		Background(sound/sipmanageivr);
		WaitExten(20);
	}
	1 => {
		goto sip-bind, s, 1;
	}
	2 => {
		goto sip-query, s, 1;
	}
	3 => {
		goto sip-login, s, 1;
	}
	4 => {
		goto sip-logout, s, 1;
	}
	i => {
		Playback(sound/incorrect);
		goto s,1;
	}
	t => {
		Playback(sound/timeout);
		goto s,1;
	}
}
context sip-bind {
	s => {
		input="";
		Background(sound/inputexten);
		loop:
		WaitExten(20);
	}
	_[0-9] => {
		input=${input}${EXTEN};
		goto s,loop;
	}
	* => {
		input="";
		goto s,1;
	}
	# => {
		if("${input}a" == "a"){
			Playback(sound/inputextenerror);
			goto s,1;
		}
		bindsucceed=0;
		Agi(agi://127.0.0.1:7891/agibindexten?pbx=${HOST}&exten=${input});
		if(${bindsucceed} == 0){
			Playback(sound/failed);
			goto sip-manage, s, 1;
		} else {
			Playback(sound/succeed);
			Wait(1);
			Hangup;
		}
	}
	t => {
		Playback(sound/timeout);
		goto s,1;
	}
}

context sip-query {
	s => {
		querysucceed=0;
		Agi(agi://127.0.0.1:7891/agibindquery?pbx=${HOST});
		if(${querysucceed} == 0){
			Playback(sound/failed);
			goto sip-manage, s, 1;
		} else {
			Wait(1);
			goto sip-manage, s, 1;
		}
	}
}

context sip-login {
	s => {
		input="7000";
		//Background(sound/inputexten);
		//loop:
		//WaitExten(20);
	//}
	//_[0-9] => {
	//	input=${input}${EXTEN};
	//	goto s,loop;
	//}
	//* => {
	//	input="";
	//	goto s,1;
	//}
	//# => {
		//if("${input}a" == "a"){
		//	Playback(sound/inputextenerror);
		//	goto s,1;
		//}
		siploginsucceed=0;
		Agi(agi://127.0.0.1:7891/agisiplogin?pbx=${HOST});
		if(${siploginsucceed} == 0){
			Playback(sound/failed);
			goto sip-manage, s, 1;
		} else if(${siploginsucceed} == 500){
                        Playback(sound/beyond);
                        goto sip-manage, s, 1;
                }else if(${siploginsucceed} == 404){
			Playback(sound/sipnotbindexten);
			goto sip-manage, s, 1;	
		} else {
			Playback(sound/succeed);
			Wait(1);
			Hangup;
		}
	}
	//t => {
	//	Playback(sound/timeout);
	//	goto s,1;
	//}
}

context sip-logout {
	s => {
		siplogoutsucceed=0;
		Agi(agi://127.0.0.1:7891/agisiplogout?pbx=${HOST});
		if(${siplogoutsucceed} == 0){
			Playback(sound/failed);
			goto sip-manage, s, 1;
		} else if(${siplogoutsucceed} == 404){
			Playback(sound/notlogined);
			Wait(1);
			Hangup;
		} else {
			Playback(sound/succeed);
			Wait(1);
			Hangup;
		}
	}
}
